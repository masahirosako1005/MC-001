# みっけ 環境設定の見本。実際の値は `python scripts/localdb.py init` が .env に自動生成します。
# .env は秘密情報を含むため絶対にコミットしないこと (.gitignore 済み)。
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=<自動生成>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=ops-<ランダム>/
# サイト運営者の画面 (専用ログイン・利用者管理・分析) の場所。本番では推測されにくい値にする (既定 ops/)
MIKKE_OPS_URL=ops/
# サイト運営者のログインの有効時間 (秒、既定 4 時間)
# MIKKE_OPS_SESSION_SECONDS=14400
DJANGO_SECURE_COOKIES=False

# nginx (https://localhost:8000) の内側で動かすとき (python scripts/devproxy.py run)
# DJANGO_SSL_REDIRECT=1
# DJANGO_SECURE_COOKIES=1
# X-Forwarded-Proto: https を信じて「HTTPS で来た」と扱う。プロキシを通さず直接公開するときは絶対に 1 にしない
# DJANGO_BEHIND_TLS_PROXY=1
# HSTS の秒数 (DEBUG=0 のとき、既定 1 年)。localhost では 0 (HSTS はポートを問わず localhost 全体に効くため)
# DJANGO_HSTS_SECONDS=0
# MIKKE_TRUSTED_PROXIES=127.0.0.1
# nginx の場所・作業フォルダ・ポート (既定 %LOCALAPPDATA%\nginx-1.28.0 / %LOCALAPPDATA%\mikke\proxy / 8000 / 8080)
# NGINX_HOME=C:\Users\<you>\AppData\Local\nginx-1.28.0
# MIKKE_PROXY_DIR=C:\Users\<you>\AppData\Local\mikke\proxy
# MIKKE_PROXY_PORT=8000
# MIKKE_APP_PORT=8080

# キャッシュ (レート制限・ログインロック・みっけ仲間の表示 ID)。複数プロセスで動かすときは db か redis://… にする
# MIKKE_CACHE=locmem
# リバースプロキシの IP / CIDR (カンマ区切り)。このときだけ X-Forwarded-For を使う
# MIKKE_TRUSTED_PROXIES=10.0.0.0/8
# IP 単位のログインロックの上限 (既定 20 回。アカウント単位は 5 回)
# MIKKE_LOGIN_MAX_FAILURES_PER_IP=20
# 「パスワードを忘れた方」に表示する問い合わせ先
# MIKKE_SUPPORT_CONTACT=みっけ運営事務局(support@example.com)
# 地図 (タイルを作り直したとき): 南,西,北,東 / 中心 / タイル名
# MIKKE_MAP_BOUNDS=34.6800,135.5150,34.7080,135.5500
# MIKKE_MAP_CENTER=34.6950,135.5330
# MIKKE_MAP_TILES=kyobashi
# 「みっけ」画面の下にスポットのカード一覧を出す
# MIKKE_SHOW_SPOT_CARDS=False

# フィールド暗号鍵 (AES-256-GCM)。"鍵ID:base64(32バイト)" をカンマ区切り。先頭が暗号化に使う現行鍵。
MIKKE_FIELD_KEYS=1:<自動生成>
# メールアドレス照合用ブラインドインデックスの HMAC 鍵
MIKKE_BLIND_INDEX_KEY=<自動生成>

# DB_ENGINE=postgresql (既定) / sqlite (PostgreSQL が使えない環境向けの代替)
DB_ENGINE=postgresql
DB_NAME=mikke
DB_USER=mikke_app
DB_PASSWORD=<自動生成>
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# ローカル PostgreSQL (scripts/localdb.py が使用)
PG_BIN=C:\Users\<you>\AppData\Local\pg17\pgsql\bin
PGDATA=C:\Users\<you>\AppData\Local\mikke\pgdata
PG_SUPERUSER_PASSWORD=<自動生成>

# 画像シンボルの一致判定に使う類似度のしきい値 (0〜1、既定 0.65 = 65%)
# MIKKE_IMAGE_SIMILARITY_THRESHOLD=0.65
